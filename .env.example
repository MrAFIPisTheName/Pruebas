# Copiá este archivo a ".env" (mismo directorio) y completá los valores antes
# de correr "npm run build" o "npm run dev". Sin estas variables, la app
# funciona igual pero el botón "Subir a Google Sheets" queda oculto.
#
# Ver el paso a paso completo en README.md, sección "Integración con Google Sheets".

# OAuth Client ID (tipo "Web application") creado en Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# ID de la Google Sheet (el valor entre /d/ y /edit en su URL).
VITE_GOOGLE_SHEET_ID=

# Pestaña + celda de inicio donde se van a agregar las filas del pedido.
VITE_GOOGLE_SHEET_RANGE=Pedidos!A1

# Autenticación (login de usuarios). Sin estas variables, la app muestra un
# aviso de "no configurada" en vez del formulario de login — nadie puede
# entrar. Ver el paso a paso en README.md, sección "Autenticación de usuarios".
# Los 4 valores salen de "Configuración del proyecto" en la consola de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
